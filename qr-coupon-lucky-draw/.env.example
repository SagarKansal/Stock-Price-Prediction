# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the filled-in copy.
#   set -a; source .env; set +a
# ---------------------------------------------------------------------------

# --- codes -----------------------------------------------------------------
# Total characters per code. Each one multiplies the number of possible codes
# by 32: 5 -> 33.5 million, 6 -> 1.07 billion. Never change this while printed
# coupons are still in circulation.
COUPON_CODE_LENGTH=5

# Optional campaign prefix, counted WITHIN the length above (so a 2-character
# prefix on a 5-character code leaves only 3 random characters, and 32,768
# possible codes). Leave empty unless you need it.
COUPON_CODE_PREFIX=

# HMAC check characters, also counted within the length. These let the server
# reject a typo without a database lookup, but each one cuts the code space by
# 32x -- rarely worth it on a short code. 0 disables the checksum entirely.
COUPON_CODE_CHECK_CHARS=0

# Hyphens inserted when the code is printed, every N characters. 0 = none.
COUPON_CODE_GROUP_SIZE=0

# Only used when COUPON_CODE_CHECK_CHARS is above zero, where it fixes the
# checksum of every code you print. Generate once, then NEVER change it while
# printed coupons are in circulation -- changing it invalidates every code.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
COUPON_CODE_SECRET=

# Accept coupon codes you wrote into the sheet yourself (they have no
# checksum). Required if you use 'import-codes' rather than 'generate'.
COUPON_ACCEPT_EXTERNAL_CODES=false

# --- public URL ------------------------------------------------------------
# Baked into every QR image at generation time. Must be the public HTTPS URL
# of this site, with no trailing slash.
COUPON_PUBLIC_BASE_URL=https://draw.example.com

# --- storage ---------------------------------------------------------------
# sqlite = everything local (development, or a campaign with no Sheets).
# sheets = the coupon list lives in Google Sheets.
COUPON_STORE=sheets
GOOGLE_CREDENTIALS_FILE=/etc/coupon/service-account.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=Coupons

# Local ledger. This is what makes a claim atomic, so it must be on durable
# disk that survives a restart -- not a container's ephemeral filesystem.
COUPON_LEDGER_PATH=/var/lib/coupon/ledger.db

# --- SMS -------------------------------------------------------------------
# console | msg91 | twilio
SMS_PROVIDER=msg91

MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# Required for Indian transactional SMS (TRAI DLT registered template).
MSG91_TEMPLATE_ID=
MSG91_ROUTE=4

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Placeholders: {name} {code} {amount} {mobile} {currency} {campaign}
SMS_TEMPLATE=Congratulations {name}! Coupon {code} has won you Rs.{amount}. Our team will contact you on {mobile} to hand over your prize.
SMS_CONSOLATION_TEMPLATE=Thank you {name}! Coupon {code} did not win a cash prize this time. Better luck next time.

# --- draw ------------------------------------------------------------------
# Amount for coupons outside every prize tier. 0 = no cash prize.
DEFAULT_PRIZE_AMOUNT=0
CURRENCY_SYMBOL=₹

# --- site ------------------------------------------------------------------
CAMPAIGN_NAME=Festive Lucky Draw
SUPPORT_PHONE=
FLASK_SECRET_KEY=
# Enables GET /admin/stats. Leave empty to keep the endpoint switched off.
COUPON_ADMIN_TOKEN=
# IN enforces a 10-digit number starting 6-9. ANY relaxes that.
MOBILE_COUNTRY=IN
# What a second scan reveals about who claimed the coupon:
# full (default) | masked (98XXXXX210) | hidden
CLAIMED_MOBILE_DISPLAY=full
RATE_LIMIT_PER_MINUTE=12
# Turn on only behind a reverse proxy you control, so client IPs are real.
TRUST_PROXY_HEADERS=true
